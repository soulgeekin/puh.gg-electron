{
  "name": "puh",
  "version": "1.0.0",
  "description": "Puh.gg desktop app for macOS",
  "main": "main.js",
  "scripts": {
    "start": "ELECTRON_RUN_AS_NODE='' electron .",
    "build": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.puh.app",
    "productName": "Puh",
    "mac": {
      "category": "public.app-category.social-networking",
      "icon": "assets/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "dmg": {
      "title": "Puh"
    }
  }
}
